# Optional path and map overrides
CSA_CATALOGUE_PATH=backend/catalogue.json
CSA_BOUNDARIES_DIR=backend/boundaries
CSA_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
CSA_DATA_DIR=backend/data
CSA_RASTERS_DIR=backend/rasters
CSA_FORECAST_LAYERS_PATH=backend/forecast_layers.json
CSA_FORECAST_DIR=backend/forecast
CSA_CROP_MODEL_DIR=backend/models/crop-classification/improved-002
CSA_HAZARD_PRODUCTS=backend/hazard_products.json
CSA_HAZARD_MODELS=backend/hazard_models.json

# Local Qwen model through LM Studio's OpenAI-compatible server
CSA_LM_STUDIO_URL=http://127.0.0.1:1234
CSA_LM_STUDIO_MODEL=qwen/qwen3.8-27b
CSA_LM_STUDIO_API_KEY=
CSA_LM_STUDIO_TIMEOUT=60

# Optional PMD integration. Keep real credentials in .env only.
CSA_PMD_URL=
CSA_PMD_USER=
CSA_PMD_PASS=
CSA_PMD_CERT_SHA256=
